  <!-- Post-build: Copy to Bannerlord Modules directory with correct structure -->
  <Target Name="CopyToBannerlord" AfterTargets="Build">
    <PropertyGroup>
      <ModOutputPath>$(BannerlordModulesPath)\AutoTrader</ModOutputPath>
    </PropertyGroup>
    <!-- Create directory structure -->
    <MakeDir Directories="$(ModOutputPath);$(ModOutputPath)\bin\Win64_Shipping_Client" />
    <!-- Copy DLL to bin\Win64_Shipping_Client -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputPath)\bin\Win64_Shipping_Client" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModOutputPath)\bin\Win64_Shipping_Client" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <!-- Copy SubModule.xml to root -->
    <Copy SourceFiles="$(ProjectDir)SubModule.xml" DestinationFiles="$(ModOutputPath)\SubModule.xml" />
    <!-- Copy GUI folder -->
    <ItemGroup>
      <GUIFiles Include="$(ProjectDir)..\GUI\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(GUIFiles)" DestinationFiles="@(GUIFiles->'$(ModOutputPath)\GUI\%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- Copy ModuleData folder -->
    <ItemGroup>
      <ModuleDataFiles Include="$(ProjectDir)..\ModuleData\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleDataFiles)" DestinationFiles="@(ModuleDataFiles->'$(ModOutputPath)\ModuleData\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Text="Deployed AutoTrader mod to $(ModOutputPath)" Importance="high" />
  </Target>
